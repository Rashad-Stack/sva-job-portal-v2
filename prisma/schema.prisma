generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Modarator {
  id        Int      @id @default(autoincrement())
  jobs      Job[]    @relation("ModaratorJobs")
  name      String
  email     String   @unique
  password  String
  role      Role     @default(MODARATOR)
  createdAt DateTime @default(now())
}

model Job {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  modaratorId Int?
  modarator   Modarator? @relation(fields: [modaratorId], references: [id], name: "ModaratorJobs")

  // Basic Information
  title          String
  companyName    String  @default("Softvence Agency")
  numberOfHiring Int     @default(1)
  appliedBy      Boolean @default(true)

  // Job Details
  location   String
  jobType    JobType
  jobLevel   JobLevel
  category   Category
  jobNature  JobNature
  shift      Shift
  googleForm String?

  deadline DateTime

  // Timestamps
  publishedAt DateTime?
  closedAt    DateTime?
}

enum Role {
  ADMIN
  MODARATOR
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
}

enum JobLevel {
  ENTRY_LEVEL
  MID_LEVEL
  ADVANCED_LEVEL
}

enum Category {
  MERN
  FRONT_END
  BACK_END
  UI_UX
  FULL_STACK
  LARAVEL
  DJANGO
}

enum JobNature {
  ONSITE
  REMOTE
}

enum Shift {
  DAY
  NIGHT
  EVENING
}
