generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MODERATOR
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
}

enum JobLevel {
  ENTRY_LEVEL
  MID_LEVEL
  ADVANCED_LEVEL
}

enum JobNature {
  ONSITE
  REMOTE
}

enum Shift {
  DAY
  NIGHT
  EVENING
}

enum ActionType {
  ADD
  EDIT
  DELETE
}

model User {
  id                String      @id @default(uuid())
  name              String
  email             String      @unique
  password          String
  role              Role
  created_at        DateTime    @default(now())
  jobs              Job[]       @relation("UserJobs")
  categories        Category[]  @relation("UserCategories")
  statuses          Status[]    @relation("UserStatuses")
  jobIndexesCreated JobIndex[]  @relation("JobIndexCreatedBy")
  jobIndexesUpdated JobIndex[]  @relation("JobIndexUpdatedBy")
  changeLogs        ChangeLog[]
}

model Job {
  id               String    @id @default(uuid())
  title            String
  company_name     String
  number_of_hiring Int
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  user_id          String
  user             User      @relation(fields: [user_id], references: [id], name: "UserJobs")
  applied_by       Boolean
  location         String
  job_type         JobType
  job_level        JobLevel
  category_id      String
  category         Category  @relation(fields: [category_id], references: [id])
  job_nature       JobNature
  shift            Shift
  google_form      String
  deadline         DateTime
  published_at     DateTime
  closed_at        DateTime
}

model Category {
  id         String     @id @default(uuid())
  name       String
  created_by String
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  creator    User       @relation(fields: [created_by], references: [id], name: "UserCategories")
  jobs       Job[]
  jobIndexes JobIndex[]
}

model Status {
  id         String     @id @default(uuid())
  name       String
  created_by String
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  creator    User       @relation(fields: [created_by], references: [id], name: "UserStatuses")
  jobIndexes JobIndex[]
}

model JobIndex {
  id                  String   @id @default(uuid())
  title               String
  job_index           String
  sheet_link          String
  admin_access        String
  candidate_form_link String
  status_id           String
  category_id         String
  created_by          String
  updated_by          String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  status     Status      @relation(fields: [status_id], references: [id])
  category   Category    @relation(fields: [category_id], references: [id])
  creator    User        @relation(fields: [created_by], references: [id], name: "JobIndexCreatedBy")
  updater    User        @relation(fields: [updated_by], references: [id], name: "JobIndexUpdatedBy")
  changeLogs ChangeLog[]
}

model ChangeLog {
  id            String     @id @default(uuid())
  user_id       String
  job_index_id  String
  action        ActionType
  field_changed String
  old_value     String
  new_value     String
  timestamp     DateTime   @default(now())

  user     User     @relation(fields: [user_id], references: [id])
  jobIndex JobIndex @relation(fields: [job_index_id], references: [id])
}
