generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String      @id @default(uuid())
  name              String
  email             String      @unique
  password          String
  role              Role        @default(MODERATOR)
  createdAt         DateTime    @default(now())
  changeLogs        ChangeLog[]
  jobs              Job[]       @relation("UserJobs")
  terminate         Boolean     @default(false)
  comment           Comment[]
  jobIndexesCreated JobIndex[]  @relation("JobIndexCreatedBy")
  jobIndexesUpdated JobIndex[]  @relation("JobIndexUpdatedBy")
}

model Job {
  id                String        @id @default(uuid())
  title             String
  companyName       String
  numberOfHiring    Int
  appliedByInternal Boolean
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  userId            String
  location          String
  jobType           JobType
  jobLevel          JobLevel
  categoryId        String?
  jobNature         JobNature
  shift             Shift
  googleForm        String
  deadline          DateTime
  slug              String
  description       String        @default("")
  minSalary         Int           @default(0)
  maxSalary         Int           @default(0)
  fields            Json?
  category          Category?     @relation(fields: [categoryId], references: [id])
  user              User          @relation("UserJobs", fields: [userId], references: [id], onDelete: Cascade)
  applications      Application[]
  templateId        String?
  template          Form?         @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Category {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  jobs       Job[]
  jobIndexes JobIndex[]
}

model Status {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  jobIndexes JobIndex[]
}

model JobIndex {
  id                String      @id @default(uuid())
  title             String
  jobPost           String
  sheetLink         String
  adminAccess       String
  candidateFormLink String
  statusId          String
  categoryId        String?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  changeLogs        ChangeLog[]
  category          Category?   @relation(fields: [categoryId], references: [id])
  creator           User?       @relation("JobIndexCreatedBy", fields: [createdBy], references: [id])
  status            Status      @relation(fields: [statusId], references: [id])
  updater           User?       @relation("JobIndexUpdatedBy", fields: [updatedBy], references: [id])
}

model ChangeLog {
  id         String     @id @default(uuid())
  userId     String
  jobIndexId String?
  action     ActionType
  oldValue   String?
  newValue   String?
  timestamp  DateTime   @default(now())
  jobIndex   JobIndex?  @relation(fields: [jobIndexId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
}

model Application {
  id                        String      @id @default(uuid())
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime?
  fullName                  String
  email                     String
  phoneNumber               String
  expectSalary              Int
  cv                        String
  githubUrl                 String
  cpProfile                 String?
  shortListStatus           ShortStat   @default(NONE)
  calStatus                 CallStat    @default(NONE)
  mailed                    MailedState @default(NOT_YET)
  designation               String?
  testResult                Int?
  level                     Level       @default(NONE)
  profile                   ProfileStat @default(NONE)
  hiringType                HiringType  @default(NONE)
  internShipProbationSalary Int?
  finalSalary               Int?
  hiringStatus              HiringStat  @default(NONE)
  profileOn                 String?
  joining                   DateTime?
  commentId                 String?
  comments                  Comment?    @relation(fields: [commentId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  jobId                     String
  job                       Job         @relation(fields: [jobId], references: [id])
  othersFields              Json?
}

model Form {
  id        String   @id @default(uuid())
  formTitle String
  fields    Field[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Job       Job[]
}

model Field {
  id        String   @id @default(uuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  title     String
  type      String
  required  Boolean  @default(false)
  column    Int      @default(12)
  options   Json // Store options as JSON, or use a separate Option model
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id            String        @id @default(uuid())
  comment       String
  userId        String
  applications  Application[]
  user          User          @relation(fields: userId, references: id)
  applicationId String
}

enum Role {
  ADMIN
  MODERATOR
  HR
  SOCIAL_MEDIA_MANAGER
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
}

enum JobLevel {
  ENTRY_LEVEL
  MID_LEVEL
  ADVANCED_LEVEL
}

enum JobNature {
  ONSITE
  REMOTE
}

enum Shift {
  DAY
  NIGHT
  EVENING
}

enum ActionType {
  ADD
  EDIT
  DELETE
}

enum ShortStat {
  SHORTLIST
  REJECTED
  NONE
}

enum CallStat {
  YES
  NOT_INTERESTED
  NO_RESPONSE
  OUT_OF_DHAKA
  NEED_OTHERS_DATE
  PHONE_OFF
  JOINED_SVA_PYTHON
  JOINED_IN_OTHERS_CONCERN
  NOT_SURE
  BUSY
  NONE
}

enum MailedState {
  SENT
  NOT_YET
}

enum Level {
  NONE
  LEVEL_A
  LEVEL_B
  LEVEL_C
  LEVEL_D
}

enum ProfileStat {
  NONE
  YES
  NO
}

enum HiringType {
  NONE
  INTERN
  PROBATION
}

enum HiringStat {
  NONE
  CONFIRMED_NEED_TO_FINAL_CALL
  PENDING_NEED_TO_DISCUSS
  WAITING_FOR_CANDIDATE_CONFIRMATION
  HIRED
  REJECTED
}
