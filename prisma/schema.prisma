generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String      @id @default(uuid())
  name              String
  email             String      @unique
  password          String
  role              Role        @default(MODERATOR)
  createdAt         DateTime    @default(now())
  changeLogs        ChangeLog[]
  jobs              Job[]       @relation("UserJobs")
  jobIndexesCreated JobIndex[]  @relation("JobIndexCreatedBy")
  jobIndexesUpdated JobIndex[]  @relation("JobIndexUpdatedBy")
}

model Job {
  id             String        @id @default(uuid())
  title          String
  companyName    String
  numberOfHiring Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String
  appliedBy      Boolean
  location       String
  jobType        JobType
  jobLevel       JobLevel
  categoryId     String?
  jobNature      JobNature
  shift          Shift
  googleForm     String
  deadline       DateTime
  slug           String
  description    String        @default("")
  minSalary      Int           @default(0)
  maxSalary      Int           @default(0)
  category       Category?     @relation(fields: [categoryId], references: [id])
  user           User          @relation("UserJobs", fields: [userId], references: [id])
  applications   Application[]
}

model Category {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  jobs       Job[]
  jobIndexes JobIndex[]
}

model Status {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  jobIndexes JobIndex[]
}

model JobIndex {
  id                String      @id @default(uuid())
  title             String
  jobPost           String
  sheetLink         String
  adminAccess       String
  candidateFormLink String
  statusId          String
  categoryId        String?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  changeLogs        ChangeLog[]
  category          Category?   @relation(fields: [categoryId], references: [id])
  creator           User?       @relation("JobIndexCreatedBy", fields: [createdBy], references: [id])
  status            Status      @relation(fields: [statusId], references: [id])
  updater           User?       @relation("JobIndexUpdatedBy", fields: [updatedBy], references: [id])
}

model ChangeLog {
  id         String     @id @default(uuid())
  userId     String
  jobIndexId String?
  action     ActionType
  oldValue   String?
  newValue   String?
  timestamp  DateTime   @default(now())
  jobIndex   JobIndex?  @relation(fields: [jobIndexId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
}

model Application {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  fullName     String
  email        String
  phoneNumber  String
  ExpectSalary Int
  cv           String
  githubUrl    String
  cpProfile    String?
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id])
}

enum Role {
  ADMIN
  MODERATOR
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
}

enum JobLevel {
  ENTRY_LEVEL
  MID_LEVEL
  ADVANCED_LEVEL
}

enum JobNature {
  ONSITE
  REMOTE
}

enum Shift {
  DAY
  NIGHT
  EVENING
}

enum ActionType {
  ADD
  EDIT
  DELETE
}
