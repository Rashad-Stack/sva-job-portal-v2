generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MODERATOR
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
}

enum JobLevel {
  ENTRY_LEVEL
  MID_LEVEL
  ADVANCED_LEVEL
}

enum JobNature {
  ONSITE
  REMOTE
}

enum Shift {
  DAY
  NIGHT
  EVENING
}

enum ActionType {
  ADD
  EDIT
  DELETE
}

model User {
  id                String      @id @default(uuid())
  name              String
  email             String      @unique
  password          String
  role              Role
  createdAt         DateTime    @default(now())
  jobs              Job[]       @relation("UserJobs")
  jobIndexesCreated JobIndex[]  @relation("JobIndexCreatedBy")
  jobIndexesUpdated JobIndex[]  @relation("JobIndexUpdatedBy")
  changeLogs        ChangeLog[]
}

model Job {
  id             String    @id @default(uuid())
  title          String
  companyName    String
  numberOfHiring Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  userId         String
  user           User      @relation(fields: [userId], references: [id], name: "UserJobs")
  appliedBy      Boolean
  location       String
  jobType        JobType
  jobLevel       JobLevel
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  jobNature      JobNature
  shift          Shift
  googleForm     String
  deadline       DateTime
}

model Category {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  jobs       Job[]
  jobIndexes JobIndex[]
}

model Status {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  jobIndexes JobIndex[]
}

model JobIndex {
  id                String   @id @default(uuid())
  title             String
  jobIndex          String
  sheetLink         String
  adminAccess       String
  candidateFormLink String
  statusId          String
  categoryId        String
  createdBy         String
  updatedBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  status     Status      @relation(fields: [statusId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  creator    User        @relation(fields: [createdBy], references: [id], name: "JobIndexCreatedBy")
  updater    User        @relation(fields: [updatedBy], references: [id], name: "JobIndexUpdatedBy")
  changeLogs ChangeLog[]
}

model ChangeLog {
  id           String     @id @default(uuid())
  userId       String
  jobIndexId   String
  action       ActionType
  fieldChanged String
  oldValue     String
  newValue     String
  timestamp    DateTime   @default(now())

  user     User     @relation(fields: [userId], references: [id])
  jobIndex JobIndex @relation(fields: [jobIndexId], references: [id])
}
